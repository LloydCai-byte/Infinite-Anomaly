extends SceneTree
const OUT="res://builds/InfiniteAnomaly-Pixel-Home-0.40.0/"
var pack=PCKPacker.new()
var files=[]
var failed=false
func check(err:Error,what:String)->void:
	if err!=OK:failed=true;printerr(what,": ",error_string(err))
func add(path:String,target:String="")->void:
	if target=="":target=path
	if files.has(target):return
	check(pack.add_file(target,path),path);files.append(target)
func _initialize()->void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT))
	var config=ConfigFile.new()
	config.set_value("application","config/name","无限异常 · 主神空间")
	config.set_value("application","config/version","0.40.0-ground-shadows")
	config.set_value("application","run/main_scene","res://scenes/pixel_home/home.tscn")
	for key in ["viewport_width","window_width_override"]:config.set_value("display","window/size/"+key,1600)
	for key in ["viewport_height","window_height_override"]:config.set_value("display","window/size/"+key,900)
	config.set_value("display","window/stretch/mode","canvas_items")
	config.set_value("display","window/size/resizable",true)
	config.set_value("rendering","renderer/rendering_method","gl_compatibility")
	config.set_value("rendering","renderer/rendering_method.mobile","gl_compatibility")
	config.set_value("rendering","textures/default_filters/use_nearest_mipmap_filter",false)
	config.set_value("audio","driver/enable_input",false)
	var config_path="res://.local/shadows-20261030/package-project.godot"
	check(config.save(config_path),"config")
	check(pack.pck_start(OUT+"InfiniteAnomaly.pck"),"start pack");add(config_path,"res://project.godot")
	add("res://scenes/pixel_hyakki/level.tscn")
	for file in ["model.gd","view.gd","equipped_battle.gd","equipment.gd","equipment_ui.gd","equipment_overlay.gd","equipment_art.gd"]:add("res://scripts/pixel_hyakki/"+file)
	for file in ["gear_base.gd","battle_base.gd","rules.gd","gear.gd","battle.gd","ui.gd"]:add("res://scripts/pixel_hyakki/progression/"+file)
	add("res://assets/pixel_campaign/progression.json")
	add("res://art/pixel-equipment-20261025/runtime/skin-plate.png")
	for file in ["model.gd","gear.gd","catalog.gd"]:add("res://scripts/turnbased/"+file)
	add("res://scripts/reboot/save_store.gd")
	for i in range(16):add("res://art/pixel-equipment-20261025/icons/%02d.png"%i)
	var art="res://art/pixel-hyakki-level-20261024/"
	add("res://assets/pixel_campaign/first_two.json")
	var campaign=JSON.parse_string(FileAccess.get_file_as_string("res://assets/pixel_campaign/first_two.json"))
	for level in campaign.levels:
		for scene in level.scenes:add(scene.image)
	add(art+"sprites/roster.json")
	var roster=JSON.parse_string(FileAccess.get_file_as_string(art+"sprites/roster.json"))
	for id in roster:
		add(art+"sprites/"+id+"/portrait.png")
		for clip in roster[id].clips:add(art+"sprites/"+id+"/"+clip+".png")
	for track in ["shot","heavy","heal","victory","defeat"]:add("res://assets/reboot/audio/"+track+".wav")
	for file in ["test_progression_ui.gd","test_progression_equipment.gd","test_campaign_package.gd"]:add("res://tests/pixel_hyakki/"+file)
	add("res://scenes/pixel_home/home.tscn")
	add("res://tests/pixel_hyakki/test_xuan_motion.gd")
	for file in ["xuan-walk.png","frames.json"]:add("res://art/xuan-motion-20261029/"+file)
	add("res://scripts/pixel_home/life.gd")
	add("res://tests/pixel_hyakki/test_xuan_reference.gd")
	for file in ["xuan-walk.png","frames.json"]:add("res://art/xuan-reference-20261029/"+file)
	add("res://tests/pixel_hyakki/test_home_life.gd")
	for file in ["living.png","xuan-walk.png","fenfen.png","gao.png","dadong.png","qiqi.png","wang.png","frames.json"]:add("res://art/home-life-20261029/"+file)
	add("res://scripts/pixel_hyakki/hud_skin.gd")
	add("res://scripts/pixel_hyakki/battle_notices.gd")
	add("res://tests/pixel_hyakki/test_feedback_round3.gd")
	for file in ["hud-atlas.png","icons.png","party-reference.png","rooms/bathroom.png"]:add("res://art/feedback-round3-20261028/"+file)
	add("res://scripts/pixel_hyakki/equipment_skin.gd")
	add("res://art/equipment-reference-20261028/reference.png")
	add("res://tests/pixel_hyakki/test_equipment_reference.gd")
	for file in ["xuan-walk.png","frames.json"]:add("res://art/xuan-proportion-20261028/"+file)
	for file in ["battle_hud.gd","travel.gd","element_vfx.gd","equipment_drag.gd","fade_screen.gd","chapter_hud.gd"]:add("res://scripts/pixel_hyakki/"+file)
	for id in ["fenfen","gao","qiqi","dadong","wang","tengu","umbrella","oni","kappa","wheel"]:add("res://art/pixel-hyakki-level-20261024/sprites/"+id+"/base.png")
	add("res://art/feedback-revision-20261028/equipment/desk.png")
	for file in ["rooms.gd","ambient.gd","ambient.gdshader","void.gdshader"]:add("res://scripts/pixel_home/"+file)
	for room in ["living","work","corridor","kitchen","bathroom","bedroom","balcony"]:add("res://art/feedback-round2-20261028/rooms/"+room+".png")
	add("res://tests/pixel_hyakki/test_feedback_round2.gd")
	for name in ["battle","effects","equipment","drag","rooms","home_runtime"]:add("res://tests/pixel_hyakki/test_feedback_"+name+".gd")
	for file in ["capture_feedback.gd","capture_feedback_room.gd"]:add("res://tools/"+file)
	for file in ["gear.gd","home.gd","intro.gd","events.gd","battle.gd","campaign.gd","campaign_ui.gd","cosmos.gd","cosmic_combat.gd","cosmos_ui.gd","content.gd","narrative.gd","finale.gd","finale_battle.gd","cycles.gd","cycles_ui.gd","cycle_combat.gd","flow_demo.gd","demo_data.gd"]:add("res://scripts/pixel_home/"+file)
	for file in ["xuan-walk.png","companions.png","fenfen-poses.png","frames.json"]:add("res://art/pixel-home-20261028/"+file)
	add("res://tests/pixel_hyakki/test_teleport.gd")
	add("res://tests/pixel_hyakki/test_home.gd")
	add("res://tests/pixel_hyakki/test_home_events.gd")
	add("res://tests/pixel_hyakki/test_campaign_progress.gd")
	add("res://tests/pixel_hyakki/test_cosmic_loadout.gd")
	add("res://tests/pixel_hyakki/test_cosmic_route.gd")
	add("res://tests/pixel_hyakki/test_finale.gd")
	add("res://tests/pixel_hyakki/test_cycles.gd")
	add("res://tests/pixel_hyakki/test_flow_demo.gd")
	add("res://tools/run_home_demo.gd")
	add("res://assets/pixel_campaign/home_events.json")
	add("res://assets/pixel_campaign/cosmos.json")
	add("res://assets/pixel_campaign/cosmic_story.json")
	add("res://assets/pixel_campaign/finale.json")
	add("res://assets/pixel_campaign/cycles.json")
	var content=load("res://scripts/pixel_home/content.gd").load_campaign()
	if not content.errors.is_empty():
		printerr("Content registry rejected: ",content.errors);quit(1);return
	for path in content.files:add(path)
	var finale=load("res://scripts/pixel_home/content.gd").load_finale()
	if not finale.errors.is_empty():
		printerr("Finale registry rejected: ",finale.errors);quit(1);return
	for id in finale.visuals:
		if content.visuals.has(id) and content.visuals[id]!=finale.visuals[id]:
			printerr("Finale appearance conflicts: ",id);quit(1);return
	for path in finale.files:add(path)
	for file in ["room_layout.gd","campaign_legacy.gd","image_cache.gd","room_save.gd"]:add("res://scripts/pixel_home/"+file)
	for file in ["test_room_campaign_migration.gd","test_room_waves_runtime.gd","test_room_ui.gd","test_room_scale.gd","test_room_save.gd","test_room_boundaries.gd","test_room_flow_demo.gd","verify_room_launcher.gd"]:add("res://tests/pixel_hyakki/"+file)
	for file in ["salvage_rules.gd","salvage_ui.gd","portal_menu.gd"]:add("res://scripts/pixel_home/"+file)
	add("res://scripts/pixel_hyakki/hud_icon.gd")
	add("res://art/feedback-room-campaign-20261029/portal-hall.png")
	for file in ["test_feedback_salvage.gd","test_feedback_room_ui.gd","test_feedback_room_scale.gd","test_feedback_room_waves.gd","verify_feedback_room_launcher.gd","verify_feedback_resources.gd"]:add("res://tests/pixel_hyakki/"+file)
	for file in ["portal_skin.gd","salvage_confirm.gd"]:add("res://scripts/pixel_home/"+file)
	add("res://scripts/pixel_hyakki/enemy_arrival.gd")
	for file in ["reference.png","plate.png"]:add("res://art/feedback-portal-polish-20261030/"+file)
	for file in ["test_portal_polish_ui.gd","test_portal_polish_salvage.gd","test_equipment_polish_reference.gd","verify_portal_polish_launcher.gd"]:add("res://tests/pixel_hyakki/"+file)
	add("res://scripts/pixel_home/room_covers.gd")
	add("res://assets/pixel_campaign/room_covers.json")
	var covers=JSON.parse_string(FileAccess.get_file_as_string("res://assets/pixel_campaign/room_covers.json"))
	for entry in covers.rooms.values():
		for kind in ["portrait","landscape"]:add(entry[kind])
	for file in ["test_room_covers.gd","verify_room_covers_launcher.gd"]:add("res://tests/pixel_hyakki/"+file)
	add("res://tools/preview_room_covers.gd")
	for file in ["typography.gd","portal_symbol.gd"]:add("res://scripts/pixel_home/"+file)
	for file in ["SourceHanSansSC-Regular.otf","SourceHanSansSC-Bold.otf","LICENSE.txt"]:add("res://assets/fonts/source-han-sans/"+file)
	for file in ["test_ui_unify.gd","verify_ui_unify_launcher.gd","verify_ui_unify_saved.gd"]:add("res://tests/pixel_hyakki/"+file)
	add("res://scripts/pixel_hyakki/ground_shadows.gd")
	add("res://assets/pixel_campaign/ground_shadows.json")
	add("res://tests/pixel_hyakki/test_ground_shadows.gd")
	add("res://tests/pixel_hyakki/verify_ground_shadows_launcher.gd")
	add("res://tools/capture_ground_shadows.gd")
	check(pack.flush(),"flush")
	var f=FileAccess.open(OUT+"files.json",FileAccess.WRITE);f.store_string(JSON.stringify(files,"  "));f.close()
	f=FileAccess.open(OUT+"GODOT-LICENSE.txt",FileAccess.WRITE);f.store_string(Engine.get_license_text()+"\n"+JSON.stringify(Engine.get_license_info(),"  "));f.close()
	print("PIXEL PACKAGE ",files.size()," files; ","FAILED" if failed else "OK");quit(1 if failed else 0)
