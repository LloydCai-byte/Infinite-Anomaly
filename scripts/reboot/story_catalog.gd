static func talk(role: int, segment: int) -> Array:
	var result=[]
	var names=["乔越","周霁","林衡","贺维"]
	for line in LATE_TALKS[role]: result.append([names[role],line])
	if segment>=2: result.append([names[role],"零号试验场已经没有东西可以藏住了。我们需要一个回答。"])
	return result
