; 无限异常 — reboot chapter one, manga flat-color production
config_version=5

[application]
config/name="无限异常"
config/description="房间里的四个人。漫画平涂自动战斗与基地养成。"
run/main_scene="res://scenes/reboot/main.tscn"
config/version="0.4.0-chapter1"
config/icon="res://assets/reboot/ui/emblem.svg"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/size/resizable=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.047, 0.065, 0.071, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[debug]
gdscript/warnings/untyped_declaration=0
file_logging/log_path="user://logs/godot.log"

[audio]
driver/enable_input=false
