extends SceneTree
const Gear=preload("res://scripts/pixel_home/gear.gd")
const Store=preload("res://scripts/pixel_home/room_save.gd")
var checks=[]
var measurements=[]
var folder="user://room-save-verification-%d/"%Time.get_ticks_usec()
func check(ok:bool,label:String)->void:
	checks.append({"pass":ok,"name":label})
	if not ok:push_error(label)
func write(path:String,text:String)->void:
	var f=FileAccess.open(path,FileAccess.WRITE);f.store_string(text);f.close()
func _initialize()->void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(folder))
	var g=Gear.new(731);g.open_profile(folder+"primary.json")
	check(g.persistence is Store,"home profile uses compressed self-contained store")
	for count in [1000,5000,20000]:
		while g.s.inventory.size()<count:g.award(1+(g.s.next_id*13)%2100,g.s.next_id%3)
		g.s.gold+=100
		var expected=g.snapshot();var times=[]
		for iteration in range(3):
			var start=Time.get_ticks_usec();var ok=g.persist();times.append((Time.get_ticks_usec()-start)/1000.0)
			check(ok,"persist diverse inventory "+str(count)+" iteration "+str(iteration))
		var read=g.persistence.load_primary()
		check(read==expected,"all items affixes seeds resources and quest fields exact at "+str(count))
		var restored=Gear.new(9);restored.open_profile(g.persistence.path)
		check(restored.persistence_enabled and restored.snapshot()==expected,"production reopen validates and restores "+str(count)+" items")
		check(g.persistence.load_backup()==expected,"previous compressed snapshot retained at "+str(count))
		measurements.append({"items":count,"save_ms":times,"bytes":FileAccess.open(g.persistence.path,FileAccess.READ).get_length()})
	var last=g.snapshot();var old_gold=g.s.gold;g.s.gold+=50;check(g.persist(),"write changed balance")
	var last_id=g.s.inventory[-1].id;var indexed=g.item_by_id(last_id)
	check(indexed==g.s.inventory[-1],"tail item lookup builds index")
	var added=g.award(2010,0);check(g.item_by_id(added.id)==added,"new drop indexes append without rebuilding bag")
	check(g.salvage(added.id) and g.item_by_id(added.id).is_empty(),"salvage removes cached item")
	var changed=g.snapshot();changed.state.inventory[-1].locked=not changed.state.inventory[-1].locked
	check(g.restore(changed) and g.item_by_id(last_id).locked==changed.state.inventory[-1].locked,"restore invalidates stale item references")
	var small=Gear.new(5);small.item_by_id(small.s.inventory[0].id)
	var replacement=Gear.new(6).s.inventory.duplicate(true);replacement[0].locked=true;small.s.inventory=replacement
	check(small.item_by_id(replacement[0].id).locked,"same-length inventory replacement invalidates the item cache")
	check(g.persistence.load_backup()==last and g.persistence.load_primary().state.gold==old_gold+50,"backup keeps preceding state")
	var backup_hash=FileAccess.get_sha256(g.persistence.path+".bak")
	write(g.persistence.path,"corrupted primary")
	var recovered=Gear.new(5);recovered.open_profile(g.persistence.path)
	check(recovered.persistence_enabled and recovered.snapshot()==last,"corrupt compressed primary recovers preceding valid snapshot")
	check(not recovered.recovery_backup.is_empty() and FileAccess.get_sha256(recovered.recovery_backup)==backup_hash,"recovered source retained as exact independent file")
	check(recovered.persist() and FileAccess.get_sha256(recovered.persistence.path+".bak")==backup_hash,"saving recovery never replaces good backup with corrupt primary")
	var legacy=Gear.Save.new(folder+"legacy.json");var old=Gear.new(42).snapshot()
	check(legacy.save(old),"create legacy variant64 snapshot")
	var compatibility=Gear.new(43);compatibility.open_profile(legacy.path)
	check(compatibility.snapshot()==old and compatibility.persistence_enabled,"legacy variant64 remains readable")
	var hash=FileAccess.get_sha256(legacy.path)
	check(compatibility.persist() and FileAccess.get_sha256(legacy.path+".bak")==hash,"first compressed write retains exact old file as backup")
	var bad=Store.new(folder+"bad.json")
	write(bad.path,"invalid");write(bad.path+".bak","invalid")
	var blocked=Gear.new(1);blocked.open_profile(bad.path)
	check(not blocked.persistence_enabled and not blocked.persist() and FileAccess.get_file_as_string(bad.path)=="invalid","two corrupt copies stop writes and retain evidence")
	var failure=Store.new(folder+"failure.json")
	check(failure.save(old),"write failure fixture")
	var original=FileAccess.get_sha256(failure.path)
	DirAccess.make_dir_recursive_absolute(failure.path+".tmp")
	check(not failure.save(last) and FileAccess.get_sha256(failure.path)==original,"unwritable temporary path leaves primary intact")
	DirAccess.remove_absolute(failure.path+".tmp")
	DirAccess.make_dir_recursive_absolute(failure.path+".bak")
	check(not failure.save(last) and FileAccess.get_sha256(failure.path)==original,"backup failure cancels replacement")
	check(not failure.save({}) and FileAccess.get_sha256(failure.path)==original,"empty snapshot never destroys primary")
	var manifest=JSON.parse_string(FileAccess.get_file_as_string(recovered.persistence.path))
	manifest.payload="x"+manifest.payload.substr(1);write(folder+"tampered.json",JSON.stringify(manifest))
	check(Store.new(folder+"tampered.json").load_primary().is_empty(),"payload checksum rejects tampering")
	manifest.raw_bytes=Store.MAX_RAW_BYTES+1;manifest.sha256=manifest.payload.sha256_text();write(folder+"oversized.json",JSON.stringify(manifest))
	check(Store.new(folder+"oversized.json").load_primary().is_empty(),"declared decompression size is bounded")
	var failures=checks.filter(func(row):return not row.pass)
	var f=FileAccess.open("res://docs/room-campaign-2000-20261029/save-verification.json",FileAccess.WRITE)
	f.store_string(JSON.stringify({"checks":checks,"failures":failures,"measurements":measurements,"normal_profile_used":false,"format":"self-contained variant64-zstd"},"\t"));f.close()
	print("ROOM_SAVE ",checks.size()," checks ",failures.size()," failures; ",JSON.stringify(measurements));quit(0 if failures.is_empty() else 1)
