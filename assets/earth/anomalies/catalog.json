        {
          "id": "K004-M01",
          "name": "借声亲属",
          "height": 193.5,
          "lore": "院门关上后，门外仍传来熟悉的问候。他记得每个人的小名，却从不记得自己刚才说过什么。衣领后垂着一道黑色侧影，只有影子会在他说话前先张开嘴。",
          "attack_steps": [
            "两手提起衣领，黑影缩向肩后",
            "身体前探，影子侧脸朝前撞击",
            "影子退回领口，双手恢复垂落"
          ],
